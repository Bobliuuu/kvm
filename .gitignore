# This repository is public. Anything that should not be published is ignored here, and AGENTS.md says why.
# run_remote.sh honors this file too, so ignored files never reach a remote GPU box either.

# Build outputs
kvm
kvm_*
*.o
*.ptx
*.cubin
*.fatbin
__pycache__/

# Private: all docs (session notes, per-task docs, plans, drafts) and raw run output
docs/
logs/

# Private: profiler output (it records host names, paths and command lines)
*.nsys-rep
*.ncu-rep
*.qdrep
*.qdstrm
*.sqlite

# Private: hosts, keys and local settings
.env
.env.*
*.pem
*.key

# Private: agent and editor folders
.claude/
.codex/
.cursor/
.agents/
.vscode/
.idea/
CLAUDE.local.md

# ABI headers and executor sources match kvm_* but are source
!include/kvm_*
!kvm_exec.cu
!demo/kvm_run.cu
!tools/kvm_build.sh

# Doom: the GPL engine source and the WAD are fetched by doom/setup.sh, never committed; build outputs
doom/third_party/
doom/build/

# demo: per-run scratch on the GPU box (rsync mirror) and local runs
runs/

# --- secrets / infrastructure identifiers: never commit (see skill github-workflow) ---
*.pem
*.key
known_hosts
.env
.env.*
vast_api_key
sw.sh
*.local.sh
